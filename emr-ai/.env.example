# Copy this to .env at the root of path-drc-emr and fill in your values

# OpenAI API key — get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# OpenMRS DB credentials (defaults are fine for local dev)
OPENMRS_DB_USER=openmrs
OPENMRS_DB_PASSWORD=openmrs
MYSQL_ROOT_PASSWORD=openmrs
